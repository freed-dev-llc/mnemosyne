# Copy to .env and adjust. All settings are optional — these are the defaults.
# Env vars are prefixed MNEMOSYNE_.

# Ollama runtime (provides both embeddings and chat).
MNEMOSYNE_OLLAMA_HOST=http://localhost:11434
MNEMOSYNE_EMBEDDING_MODEL=bge-m3
MNEMOSYNE_CHAT_MODEL=qwen2.5:1.5b
MNEMOSYNE_TEMPERATURE=0.1

# Chat backend: 'ollama' (default, local) or 'openai' for any OpenAI-compatible server
# (vLLM, llama.cpp, LM Studio). Embeddings always use Ollama regardless of this setting.
# Embeddings keep using the MNEMOSYNE_OLLAMA_HOST endpoint above, even when chat is 'openai'.
MNEMOSYNE_CHAT_PROVIDER=ollama
# Required when CHAT_PROVIDER=openai: the OpenAI-compatible chat endpoint base URL.
MNEMOSYNE_OPENAI_CHAT_BASE_URL=http://localhost:8000/v1
# API key for that endpoint. Local servers usually ignore it; set a real key if yours needs one.
MNEMOSYNE_OPENAI_API_KEY=not-needed-for-local-servers

# Where built FAISS indices live (gitignored).
MNEMOSYNE_KNOWLEDGE_DIR=knowledge

# A directory OUTSIDE the repo for manually-staged, third-party docs that must never enter
# git (issue #60). Unset by default (no staging). Per-pack: <dir>/<pack-name>/, e.g. a file
# under ~/mnemosyne-staging/ubiquiti/ is folded into the ubiquiti pack's corpus at ingest.
# MNEMOSYNE_STAGING_DIR=~/mnemosyne-staging

# Chunking + retrieval defaults (a pack manifest can override these).
MNEMOSYNE_CHUNK_SIZE=500
MNEMOSYNE_CHUNK_OVERLAP=150
MNEMOSYNE_TOP_K=5

# Relevance floor: max embedding distance (L2 over unit-norm bge-m3, range 0-2) a chunk may
# have to count as relevant. A query with nothing close enough retrieves nothing and `ask`
# answers "not in the knowledge base" instead of guessing over unrelated context. Set to
# `none` (synonyms: `null`, empty) to disable and restore the always-return-top-k behavior.
MNEMOSYNE_SCORE_FLOOR=1.0

# Unit-normalize embeddings at index and query time so FAISS L2 ranks identically to cosine.
# A no-op for the default bge-m3 (already unit-norm); kept for a future non-normalized model.
# Changing this requires rebuilding the index (mnemosyne ingest).
MNEMOSYNE_FAISS_NORMALIZE=false

# =========================================================================
# Agent Orchestration (Sage, Nova, Vera, Haiku)
# =========================================================================

# Active agent profile: local-only, hybrid (default), or cloud-only
# - local-only: All agents use Ollama/vLLM/llama.cpp (zero cost, offline)
# - hybrid: Sage/Nova/Vera use cloud APIs, Haiku uses Ollama (balanced)
# - cloud-only: All agents use cloud APIs (Claude, Kimi, Codex, etc.)
MNEMOSYNE_AGENT_PROFILE=hybrid

# =========================================================================
# Cloud API Keys (required for hybrid/cloud-only profiles)
# =========================================================================

# Anthropic Claude API (primary for cloud-only/hybrid profiles)
ANTHROPIC_API_KEY=your-anthropic-key-here

# Moonshot (Kimi) — Chinese LLM, long context, lower cost than Claude
# MOONSHOT_API_KEY=your-moonshot-key-here

# =========================================================================
# Local LLM Configuration (used by local-only/hybrid profiles)
# =========================================================================

# Ollama: http://localhost:11434 (default). Pulls models on demand.
# Examples: llama2:70b, llama2:13b, qwen2.5:1.5b, mistral
# OLLAMA_HOST=http://localhost:11434

# vLLM: High-throughput local inference. http://localhost:8000 (default port)
# Requires manual setup; good for batch workloads and large models.
# VLLM_HOST=http://localhost:8000

# llama.cpp: CPU-friendly local inference. http://localhost:8080 (default port)
# Good for small models (1-7B) on limited hardware.
# LLAMA_CPP_HOST=http://localhost:8080
